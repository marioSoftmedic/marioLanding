---
import QRCode from 'qrcode';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/marioHealthBits4.png';

// src/pages/card.astro
// Tarjeta Digital Mobile-First para Mario Inostroza M.
const title = "Mario Inostroza M. | Tarjeta de Contacto";
const description = "Tecnólogo Médico · Emprendedor · AI Systems & Deep Tech Architect. Construyo infraestructura inteligente digital. Fundador de Examya, Velerio y DeepTech. Patagonia, Chile.";
const vcfUrl = "/mario-inostroza.vcf";
const cardUrl = "https://mariohealthbits.dev/card/";

// Generado de forma estática en tiempo de build (SVG puro embebido, cero dependencias en cliente)
const qrSvg = await QRCode.toString(cardUrl, {
  type: 'svg',
  margin: 1,
  color: {
    dark: '#000000',
    light: '#ffffff',
  },
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Mario Inostroza" />
    <meta name="theme-color" content="#09090b" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content="https://mariohealthbits.dev/card" />
    <meta property="og:image" content="https://mariohealthbits.dev/og-default.png" />

    <style>
      :root {
        --bg: #09090b;
        --card-bg: #121215;
        --card-border: rgba(255, 255, 255, 0.08);
        --text: #f4f4f5;
        --text-muted: #a1a1aa;
        --text-dim: #71717a;
        --accent: #38bdf8;
        --accent-glow: rgba(56, 189, 248, 0.15);
        --emerald: #10b981;
        --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", sans-serif;
        --font-mono: "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
        --font-serif: -apple-system-ui-serif, Georgia, "Times New Roman", serif;
        --radius-sm: 10px;
        --radius-md: 14px;
        --radius-lg: 24px;
        --radius-full: 9999px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        -webkit-tap-highlight-color: transparent;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--bg);
        color: var(--text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px 16px 40px;
      }

      .card-container {
        width: 100%;
        max-width: 410px;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-lg);
        padding: 32px 24px 28px;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7);
        position: relative;
      }

      .avatar-wrap {
        position: relative;
        margin-bottom: 16px;
      }

      .avatar {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        padding: 3px;
        background: linear-gradient(160deg, #f97316, #06b6d4);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow:
          0 0 35px -5px rgba(249, 115, 22, 0.4),
          0 0 35px -5px rgba(6, 182, 212, 0.35),
          0 12px 24px -8px rgba(0, 0, 0, 0.7);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }

      .avatar:hover {
        transform: scale(1.04);
        box-shadow:
          0 0 45px -2px rgba(249, 115, 22, 0.5),
          0 0 45px -2px rgba(6, 182, 212, 0.45),
          0 16px 30px -8px rgba(0, 0, 0, 0.8);
      }

      .avatar-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        object-position: center 12%;
        display: block;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.25);
        padding: 4px 10px;
        border-radius: var(--radius-full);
        font-family: var(--font-mono);
        font-size: 10px;
        color: #34d399;
        margin-bottom: 10px;
      }

      .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--emerald);
        box-shadow: 0 0 8px var(--emerald);
      }

      .person-name {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin-bottom: 4px;
        text-align: center;
      }

      .person-subtitle-italic {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 14px;
        color: var(--text-muted);
        margin-bottom: 4px;
        text-align: center;
        letter-spacing: 0.02em;
      }

      .person-title {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--accent);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 6px;
        text-align: center;
      }

      .person-tagline {
        font-size: 13.5px;
        font-weight: 600;
        color: #38bdf8;
        background: linear-gradient(135deg, #38bdf8 0%, #a5f3fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-align: center;
        margin-bottom: 8px;
        letter-spacing: -0.01em;
        line-height: 1.35;
      }

      .ecosystem-badge {
        font-size: 11px;
        color: var(--accent);
        opacity: 0.9;
        margin-bottom: 8px;
        text-align: center;
        font-family: var(--font-mono);
      }

      .location-badge {
        font-size: 12px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 22px;
      }

      /* Primary Button: Save Contact */
      .btn-save-vcard {
        width: 100%;
        background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
        color: #041017;
        border: none;
        border-radius: var(--radius-md);
        padding: 15px;
        font-size: 14.5px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        cursor: pointer;
        box-shadow: 0 8px 24px -4px rgba(56, 189, 248, 0.4);
        transition: transform 0.2s, box-shadow 0.2s;
        margin-bottom: 18px;
      }

      .btn-save-vcard:active {
        transform: scale(0.98);
      }

      /* Quick Links Grid */
      .links-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        width: 100%;
        margin-bottom: 16px;
      }

      .link-tile {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: var(--radius-sm);
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
        text-decoration: none;
        color: var(--text);
        transition: all 0.2s;
      }

      .link-tile:hover, .link-tile:active {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--accent);
        transform: translateY(-1px);
      }

      .tile-icon {
        width: 20px;
        height: 20px;
        color: var(--accent);
      }

      .tile-label {
        font-family: var(--font-mono);
        font-size: 10px;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .tile-val {
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
      }

      .address-box {
        width: 100%;
        background: rgba(255, 255, 255, 0.02);
        border: 1px dashed rgba(255, 255, 255, 0.08);
        border-radius: var(--radius-sm);
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.2s;
      }

      .address-box:hover {
        border-color: var(--accent);
      }

      .address-text {
        font-size: 11px;
        color: var(--text-muted);
        line-height: 1.35;
      }

      .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding-top: 14px;
        border-top: 1px solid var(--card-border);
      }

      .footer-link {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 12px;
        font-family: var(--font-mono);
        display: flex;
        align-items: center;
        gap: 6px;
        transition: color 0.2s;
      }

      .footer-link:hover {
        color: var(--accent);
      }

      .btn-show-qr {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 11px;
        padding: 6px 12px;
        border-radius: var(--radius-full);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
      }

      .btn-show-qr:hover {
        color: var(--text);
        border-color: var(--accent);
      }

      /* Modal QR */
      .qr-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        z-index: 999;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .qr-modal.active {
        display: flex;
      }

      .qr-modal-box {
        background: #111114;
        border: 1px solid var(--card-border);
        border-radius: var(--radius-lg);
        padding: 30px;
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: 320px;
        width: 100%;
        text-align: center;
      }

      .qr-code-img {
        width: 200px;
        height: 200px;
        background: #ffffff;
        border-radius: 12px;
        padding: 8px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .qr-code-img svg {
        width: 100%;
        height: 100%;
        display: block;
      }

      .qr-code-img img, .qr-code-img canvas {
        width: 100% !important;
        height: 100% !important;
      }

      .btn-close-modal {
        background: var(--card-border);
        color: var(--text);
        border: none;
        padding: 8px 20px;
        border-radius: var(--radius-full);
        font-size: 12px;
        cursor: pointer;
        margin-top: 12px;
      }
    </style>
  </head>
  <body>
    <main class="card-container">
      <div class="avatar-wrap">
        <div class="avatar">
          <Image
            src={heroImage}
            alt="Mario Inostroza M."
            width={192}
            height={192}
            class="avatar-img"
            loading="eager"
          />
        </div>
      </div>

      <div class="status-pill">
        <span class="status-dot"></span>
        <span>Available for Advisory & Projects</span>
      </div>

      <h1 class="person-name">Mario Inostroza M.</h1>
      <div class="person-subtitle-italic">Tecnólogo Médico · Emprendedor</div>
      <div class="person-title">AI Systems & Deep Tech Architect</div>
      <div class="person-tagline">«Construyo infraestructura inteligente digital»</div>
      <div class="ecosystem-badge">
        Examya (Salud) · Velerio (Turismo) · DeepTech (Comercio)
      </div>

      <div class="location-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Puerto Natales, Patagonia · Chile
      </div>

      <!-- BOTÓN PRINCIPAL: GUARDAR CONTACTO -->
      <a href={vcfUrl} download="Mario_Inostroza.vcf" class="btn-save-vcard">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        Guardar en Contactos (.vcf)
      </a>

      <!-- TILES DE ACCIÓN RÁPIDA -->
      <div class="links-grid">
        <a href="https://wa.me/56962170366?text=Hola%20Mario,%20te%20escribo%20desde%20tu%20tarjeta%20digital" class="link-tile" target="_blank" rel="noopener">
          <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span class="tile-label">WhatsApp</span>
          <span class="tile-val">+56 9 6217 0366</span>
        </a>

        <a href="mailto:mario.inostroza.m@gmail.com" class="link-tile">
          <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span class="tile-label">Email</span>
          <span class="tile-val">mario.inostroza.m...</span>
        </a>

        <a href="https://www.linkedin.com/in/mario-inostroza-softmedic/" class="link-tile" target="_blank" rel="noopener">
          <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          <span class="tile-label">LinkedIn</span>
          <span class="tile-val">in/mario-inostroza</span>
        </a>

        <a href="https://instagram.com/mario.inostroza.m" class="link-tile" target="_blank" rel="noopener">
          <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          <span class="tile-label">Instagram</span>
          <span class="tile-val">@mario.inostroza.m</span>
        </a>

        <a href="https://youtube.com/@mario.inostroza.m" class="link-tile" target="_blank" rel="noopener">
          <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
          <span class="tile-label">YouTube</span>
          <span class="tile-val">@mario.inostroza.m</span>
        </a>

        <a href="/" class="link-tile">
          <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span class="tile-label">Blog / Web</span>
          <span class="tile-val">mariohealthbits.dev</span>
        </a>
      </div>

      <a href="https://maps.google.com/?q=Patagonia+857,+Puerto+Natales,+Magallanes,+Chile" class="address-box" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <div class="address-text">
          <strong>Base:</strong> Patagonia 857, Puerto Natales, Magallanes y Antártica Chilena.
        </div>
      </a>

      <div class="card-footer">
        <a href="/" class="footer-link">
          ← Ir al Inicio
        </a>
        <button class="btn-show-qr" id="open-qr-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Mostrar QR
        </button>
      </div>
    </main>

    <!-- Modal con QR -->
    <div class="qr-modal" id="qr-modal">
      <div class="qr-modal-box">
        <div class="qr-code-img" set:html={qrSvg}></div>
        <p style="font-size: 13px; font-weight: 600; margin-bottom: 4px;">mariohealthbits.dev/card</p>
        <p style="font-size: 11px; color: var(--text-muted);">Escanear para abrir esta tarjeta o guardar contacto.</p>
        <div style="display: flex; gap: 8px; margin-top: 14px;">
          <a href="/img/card-qr.png" download="mario-inostroza-qr.png" style="background: rgba(255,255,255,0.08); border: 1px solid var(--card-border); color: var(--text); padding: 8px 16px; border-radius: var(--radius-full); font-size: 12px; text-decoration: none; display: inline-flex; align-items: center;">
            Descargar QR
          </a>
          <button class="btn-close-modal" id="close-qr-btn">Cerrar</button>
        </div>
      </div>
    </div>

    <!-- Script ligero para abrir/cerrar modal (sin dependencias externas) -->
    <script is:inline>
      const modal = document.getElementById("qr-modal");
      const openBtn = document.getElementById("open-qr-btn");
      const closeBtn = document.getElementById("close-qr-btn");

      openBtn?.addEventListener("click", () => {
        modal.classList.add("active");
      });

      closeBtn?.addEventListener("click", () => {
        modal.classList.remove("active");
      });

      modal?.addEventListener("click", (e) => {
        if (e.target === modal) modal.classList.remove("active");
      });
    </script>
  </body>
</html>
