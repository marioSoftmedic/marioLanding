---
import Base from '../../layouts/Base.astro';
import AuthorTrustPage from '../../components/AuthorTrustPage.astro';
import { buildAuthorPageSchema } from '../../lib/schema';

const title = 'Author and editorial policy — Mario Inostroza';
const description = 'Identity, experience, editorial method, and corrections for mariohealthbits.dev.';
const breadcrumbs = [{ name: 'Home', path: '/en/' }, { name: 'Author and editorial policy', path: '/en/author/' }];
const schema = buildAuthorPageSchema({ name: title, description, lang: 'en', path: '/en/author/', breadcrumbs });
---
<Base title={title} description={description} alternatePath="/autor/" schema={schema}>
	<AuthorTrustPage lang="en" />
</Base>
