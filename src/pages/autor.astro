---
import Base from '../layouts/Base.astro';
import AuthorTrustPage from '../components/AuthorTrustPage.astro';
import { buildAuthorPageSchema } from '../lib/schema';

const title = 'Autor y política editorial — Mario Inostroza';
const description = 'Identidad, experiencia, método editorial y correcciones de mariohealthbits.dev.';
const breadcrumbs = [{ name: 'Inicio', path: '/' }, { name: 'Autor y política editorial', path: '/autor/' }];
const schema = buildAuthorPageSchema({ name: title, description, lang: 'es', path: '/autor/', breadcrumbs });
---
<Base title={title} description={description} alternatePath="/en/author/" schema={schema}>
	<AuthorTrustPage lang="es" />
</Base>
