---
interface Props {
  id: string;
  title?: string;
  label?: string;
}

const { id: rawId, title = 'Video', label } = Astro.props;

function extractYouTubeId(input: string): string {
  const match = input.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
  return match ? match[1] : input.trim();
}

const id = extractYouTubeId(rawId);
---

<div class="youtube-embed-wrapper my-8 rounded-2xl overflow-hidden" style="border: 1px solid var(--border-subtle); background: var(--bg-surface);">
  <div
    class="youtube-facade relative w-full aspect-video cursor-pointer group flex items-center justify-center overflow-hidden bg-black"
    data-youtube-id={id}
    data-title={title}
    role="button"
    tabindex="0"
    aria-label={`Reproducir video: ${title}`}
  >
    <img
      src={`https://i.ytimg.com/vi/${id}/maxresdefault.jpg`}
      alt={title}
      loading="lazy"
      decoding="async"
      width="1280"
      height="720"
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105 opacity-90 group-hover:opacity-100"
      onerror="this.onerror=null; this.src='https://i.ytimg.com/vi/' + this.dataset.id + '/hqdefault.jpg';"
      data-id={id}
    />

    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>

    <div
      class="absolute flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full transition-all duration-300 transform group-hover:scale-110 shadow-2xl"
      style="background: rgba(15, 15, 23, 0.85); backdrop-filter: blur(8px); border: 1px solid var(--border-strong);"
    >
      <svg
        class="w-7 h-7 sm:w-8 sm:h-8 text-white transition-colors duration-200 group-hover:text-red-500 ml-1"
        fill="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M8 5v14l11-7z" />
      </svg>
    </div>

    {label && (
      <div class="absolute bottom-3 left-3 px-3 py-1 rounded-md text-xs font-medium tracking-wide text-white bg-black/60 backdrop-blur-sm border border-white/10 pointer-events-none">
        {label}
      </div>
    )}
  </div>
</div>

<script>
  function setupYouTubeFacades() {
    const facades = document.querySelectorAll('.youtube-facade:not([data-initialized])');
    facades.forEach((facade) => {
      facade.setAttribute('data-initialized', 'true');

      const activate = () => {
        const id = facade.getAttribute('data-youtube-id');
        const title = facade.getAttribute('data-title') || 'YouTube Video';
        if (!id) return;

        const iframe = document.createElement('iframe');
        iframe.setAttribute('src', `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`);
        iframe.setAttribute('title', title);
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
        iframe.setAttribute('allowfullscreen', 'true');
        iframe.setAttribute('loading', 'lazy');
        iframe.className = 'w-full h-full border-0 absolute inset-0';

        facade.innerHTML = '';
        facade.appendChild(iframe);
        facade.removeAttribute('role');
        facade.removeAttribute('tabindex');
        facade.removeAttribute('aria-label');
        facade.classList.remove('cursor-pointer', 'group');
      };

      facade.addEventListener('click', activate);
      facade.addEventListener('keydown', (e) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
          e.preventDefault();
          activate();
        }
      });
    });
  }

  setupYouTubeFacades();
  document.addEventListener('astro:page-load', setupYouTubeFacades);
</script>
