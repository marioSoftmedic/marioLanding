---
import { getLang } from '../i18n/utils';

interface Props {
  currentPath: string;
  alternatePath: string | null;
}

const { currentPath, alternatePath } = Astro.props;
const isEn = getLang(currentPath) === 'en';
const esPath = isEn ? alternatePath : currentPath;
const enPath = isEn ? currentPath : alternatePath;
---

<div role="group" aria-label={isEn ? 'Change language' : 'Cambiar idioma'} class="flex items-center gap-0.5 rounded-lg p-1" style="background: var(--bg-elevated); border: 1px solid var(--border-subtle);">
  {esPath ? (
    <a href={esPath} hreflang="es" aria-label="Ver sitio en Español" aria-current={!isEn ? 'true' : undefined} class="px-2.5 py-1 text-xs font-semibold rounded-md transition-all duration-200 min-w-[2rem] text-center" style={!isEn ? 'background: var(--bg-surface); color: var(--text-primary); border: 1px solid var(--border-default);' : 'color: var(--text-muted);'}>ES</a>
  ) : (
    <span aria-disabled="true" title="Solo disponible en inglés" class="px-2.5 py-1 text-xs font-semibold rounded-md min-w-[2rem] text-center cursor-not-allowed opacity-40" style="color: var(--text-faint);">ES</span>
  )}
  {enPath ? (
    <a href={enPath} hreflang="en" aria-label="View site in English" aria-current={isEn ? 'true' : undefined} class="px-2.5 py-1 text-xs font-semibold rounded-md transition-all duration-200 min-w-[2rem] text-center" style={isEn ? 'background: var(--bg-surface); color: var(--text-primary); border: 1px solid var(--border-default);' : 'color: var(--text-muted);'}>EN</a>
  ) : (
    <span aria-disabled="true" title="Only available in Spanish" class="px-2.5 py-1 text-xs font-semibold rounded-md min-w-[2rem] text-center cursor-not-allowed opacity-40" style="color: var(--text-faint);">EN</span>
  )}
</div>
